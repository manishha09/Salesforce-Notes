4. Heap → Apex heap size too large
apex
// ❌ BREAKS — materializes millions of rows + all fields into 6MB heap
public static void reportAll_broken() {
    List<Account> all = [SELECT Id, Name, Description, /* ...50 fields... */ FROM Account];
    Integer count = 0;
    for (Account a : all) { count++; }
}
apex
// ✅ FIXED — SOQL for-loop streams in 200-row chunks, heap stays flat
public static void reportAll_fixed() {
    Integer count = 0;
    for (Account a : [SELECT Id FROM Account]) {   // only the field you use, chunked fetch
        count++;
    }
}

Two fixes stacked: for (X x : [SELECT...]) streams rather than loading everything at once, and querying only Id instead of 50 fields cuts per-row heap. For truly large volumes this becomes Batch Apex, where each chunk is a fresh 6 MB.

The test that proves it — and catches a fix that only looks fixed
apex
@IsTest
private class GovernorLimitTest {

    @IsTest
    static void fixedVersion_survives201() {

        Account a = new Account(Name = 'Parent');
        insert a;

        List<Opportunity> opps = new List<Opportunity>();
        for (Integer i = 0; i < 201; i++) {          // 201 forces 2 chunks
            opps.add(new Opportunity(
                Name = 'Opp ' + i, StageName = 'Prospecting',
                CloseDate = Date.today().addDays(30), AccountId = a.Id
            ));
        }
        insert opps;

        Test.startTest();
        LimitDemo.createTasks_fixed(opps);
        Test.stopTest();

        // proves ALL processed, and proves it was 1 DML not 201
        Assert.areEqual(201, [SELECT COUNT() FROM Task]);
        Assert.areEqual(1, Limits.getDmlStatements(),
            'Must be a single bulk DML, not one-per-record');
    }
}

The Assert on Limits.getDmlStatements() is what makes this a real test — a version that passed the count assertion but still looped its DML would fail here.

