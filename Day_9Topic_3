Test Class

@IsTest
private class AccountMissingPhoneBatchTest {

    @TestSetup
    static void setup() {
        List<Account> accts = new List<Account>();
        for (Integer i = 0; i < 150; i++) {
            accts.add(new Account(Name = 'No Phone ' + i));           // Phone null
        }
        for (Integer i = 0; i < 50; i++) {
            accts.add(new Account(Name = 'Has Phone ' + i, Phone = '555-0100'));
        }
        insert accts;
    }

    @IsTest
    static void flagsOnlyAccountsMissingPhone() {

        Test.startTest();
        Database.executeBatch(new AccountMissingPhoneBatch(), 200);
        Test.stopTest();

        System.assertEquals(150, [
            SELECT COUNT() FROM Account WHERE Data_Quality_Flag__c = 'Missing Phone'
        ], 'All phoneless accounts should be flagged');

        System.assertEquals(0, [
            SELECT COUNT() FROM Account
            WHERE Phone != null AND Data_Quality_Flag__c = 'Missing Phone'
        ], 'Accounts with a phone should be untouched');
    }

    @IsTest
    static void statefulCountersAccumulateAcrossChunks() {

        // Only ONE execute() runs in a test context regardless of scope,
        // so exercise multi-chunk accumulation by calling execute() directly.
        AccountMissingPhoneBatch b = new AccountMissingPhoneBatch();

        List<Account> all = [SELECT Id, Phone FROM Account WHERE Phone = null];
        List<Account> chunkOne = new List<Account>();
        List<Account> chunkTwo = new List<Account>();

        for (Integer i = 0; i < all.size(); i++) {
            if (i < 75) chunkOne.add(all[i]); else chunkTwo.add(all[i]);
        }

        Test.startTest();
        b.execute(null, chunkOne);
        b.execute(null, chunkTwo);
        Test.stopTest();

        System.assertEquals(150, b.recordsProcessed, 'Counter must survive both chunks');
        System.assertEquals(150, b.recordsUpdated);
        System.assertEquals(0,   b.recordsFailed);
    }
}

That second test is the one that actually proves Database.Stateful is doing its job. The first test can't — with only one execute() invocation running under Test.stopTest(), the counters would read correctly even if you removed the interface entirely.
