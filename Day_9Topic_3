Batch Class

/**
 * Flags Accounts that have no Phone value so they can be surfaced
 * in a data-quality report. Tracks running counts across all chunks.
 */
global class AccountMissingPhoneBatch implements Database.Batchable<sObject>,
                                                  Database.Stateful {

    // Instance variables persist across execute() calls because of Database.Stateful.
    global Integer recordsProcessed = 0;
    global Integer recordsUpdated   = 0;
    global Integer recordsFailed    = 0;

    // Bounded — never let this grow unbounded across millions of records.
    global List<String> failureMessages = new List<String>();
    private static final Integer MAX_LOGGED_FAILURES = 20;

    private String notifyEmail;

    global AccountMissingPhoneBatch() {
        this.notifyEmail = UserInfo.getUserEmail();
    }

    // ---------- start ----------

    global Database.QueryLocator start(Database.BatchableContext bc) {
        return Database.getQueryLocator([
            SELECT Id, Name, Phone, Data_Quality_Flag__c, Last_Audited__c
            FROM Account
            WHERE Phone = null
            ORDER BY CreatedDate
        ]);
    }

    // ---------- execute ----------

    global void execute(Database.BatchableContext bc, List<Account> scope) {

        List<Account> toUpdate = new List<Account>();

        for (Account a : scope) {
            recordsProcessed++;

            // Re-verify. The QueryLocator snapshots at start time, so a record
            // may have gained a Phone value since the job began.
            if (String.isNotBlank(a.Phone)) {
                continue;
            }

            toUpdate.add(new Account(
                Id                   = a.Id,
                Data_Quality_Flag__c = 'Missing Phone',
                Last_Audited__c      = System.today()
            ));
        }

        if (toUpdate.isEmpty()) {
            return;
        }

        // Partial success — one bad record shouldn't cost the whole chunk.
        List<Database.SaveResult> results = Database.update(toUpdate, false);

        for (Integer i = 0; i < results.size(); i++) {
            if (results[i].isSuccess()) {
                recordsUpdated++;
            } else {
                recordsFailed++;
                if (failureMessages.size() < MAX_LOGGED_FAILURES) {
                    failureMessages.add(
                        toUpdate[i].Id + ': ' + results[i].getErrors()[0].getMessage()
                    );
                }
            }
        }
    }

    // ---------- finish ----------

    global void finish(Database.BatchableContext bc) {

        AsyncApexJob job = [
            SELECT Id, Status, NumberOfErrors, JobItemsProcessed,
                   TotalJobItems, ExtendedStatus
            FROM AsyncApexJob
            WHERE Id = :bc.getJobId()
        ];

        String body =
            'Account phone audit complete.\n\n' +
            'Status: '            + job.Status            + '\n' +
            'Chunks: '            + job.JobItemsProcessed + ' of ' + job.TotalJobItems + '\n' +
            'Records processed: ' + recordsProcessed      + '\n' +
            'Records updated: '   + recordsUpdated        + '\n' +
            'Records failed: '    + recordsFailed         + '\n';

        if (!failureMessages.isEmpty()) {
            body += '\nSample failures (first ' + MAX_LOGGED_FAILURES + '):\n'
                  + String.join(failureMessages, '\n');
        }

        Messaging.SingleEmailMessage mail = new Messaging.SingleEmailMessage();
        mail.setToAddresses(new List<String>{ notifyEmail });
        mail.setSubject('Account Phone Audit — ' + job.Status);
        mail.setPlainTextBody(body);

        Messaging.sendEmail(new List<Messaging.SingleEmailMessage>{ mail });
    }
}

Run it:

Database.executeBatch(new AccountMissingPhoneBatch(), 200);

Why the counters need Database.Stateful

Without it, recordsProcessed resets to 0 at the start of every chunk. Each execute() gets a freshly deserialized instance — only static final values survive. finish() would report the count from the last chunk only, which on a 200-scope job over 10,000 records would read 200 instead of 10,000.

Three things worth flagging about the state here:

failureMessages is capped at 20. An uncapped list across a large job serializes between every chunk and will eventually hit the 12 MB heap limit.
notifyEmail is set in the constructor and read in finish() — another legitimate use of Stateful, since without it the value would be lost.
If all you needed were chunk counts, AsyncApexJob.JobItemsProcessed gives you that for free and you could skip Stateful entirely. It's the record-level counters that require it.

