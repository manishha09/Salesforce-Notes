Callout from a trigger

public with sharing class ErpSyncService {

    private static final String ENDPOINT = 'callout:ERP_Named_Cred/api/v1/accounts';

    @future(callout=true)
    public static void syncAccounts(Set<Id> accountIds) {

        if (accountIds == null || accountIds.isEmpty()) {
            return;
        }

        // Re-query. The record state at enqueue time is not trustworthy —
        // this is exactly why sObjects can't be passed as parameters.
        List<Account> accts = [
            SELECT Id, Name, AccountNumber, Industry, BillingCountry
            FROM Account
            WHERE Id IN :accountIds
        ];

        if (accts.isEmpty()) {
            return;
        }

        List<Account> toUpdate = new List<Account>();
        List<Integration_Log__c> logs = new List<Integration_Log__c>();

        for (Account a : accts) {

            HttpRequest req = new HttpRequest();
            req.setEndpoint(ENDPOINT);
            req.setMethod('POST');
            req.setHeader('Content-Type', 'application/json');
            req.setTimeout(20000);
            req.setBody(JSON.serialize(new Map<String, Object>{
                'externalId' => a.Id,
                'name'       => a.Name,
                'number'     => a.AccountNumber,
                'industry'   => a.Industry,
                'country'    => a.BillingCountry
            }));

            try {
                HttpResponse res = new Http().send(req);

                if (res.getStatusCode() >= 200 && res.getStatusCode() < 300) {
                    Map<String, Object> body =
                        (Map<String, Object>) JSON.deserializeUntyped(res.getBody());

                    toUpdate.add(new Account(
                        Id                = a.Id,
                        ERP_Id__c         = (String) body.get('erpId'),
                        Last_Synced__c    = System.now(),
                        Sync_Status__c    = 'Success'
                    ));
                } else {
                    toUpdate.add(new Account(
                        Id             = a.Id,
                        Sync_Status__c = 'Failed'
                    ));
                    logs.add(buildLog(a.Id, 'HTTP ' + res.getStatusCode(), res.getBody()));
                }

            } catch (CalloutException e) {
                toUpdate.add(new Account(Id = a.Id, Sync_Status__c = 'Failed'));
                logs.add(buildLog(a.Id, 'CalloutException', e.getMessage()));
            }
        }

        // No user is watching this transaction — partial success beats
        // an all-or-nothing rollback that loses every successful sync.
        if (!toUpdate.isEmpty()) {
            Database.update(toUpdate, false);
        }
        if (!logs.isEmpty()) {
            Database.insert(logs, false);
        }
    }

    private static Integration_Log__c buildLog(Id recordId, String type, String detail) {
        return new Integration_Log__c(
            Record_Id__c = recordId,
            Error_Type__c = type,
            Detail__c = detail != null ? detail.left(32000) : null
        );
    }
}

Trigger side, with the recursion guard:

trigger AccountTrigger on Account (after insert, after update) {

    if (Trigger.isAfter && (Trigger.isInsert || Trigger.isUpdate)) {

        // The future method updates Account, which re-fires this trigger.
        // Without a guard you loop until the 50-invocation limit blows.
        if (!ErpSyncGuard.hasRun && !System.isFuture() && !System.isBatch()) {
            ErpSyncGuard.hasRun = true;

            Set<Id> changed = new Set<Id>();
            for (Account a : Trigger.new) {
                Account old = Trigger.isUpdate ? Trigger.oldMap.get(a.Id) : null;
                if (old == null || a.Name != old.Name || a.Industry != old.Industry) {
                    changed.add(a.Id);
                }
            }

            if (!changed.isEmpty()) {
                ErpSyncService.syncAccounts(changed);
            }
        }
    }
}

public class ErpSyncGuard {
    public static Boolean hasRun = false;
}

Two details that matter here: the System.isFuture() check prevents the callback update from re-entering, and filtering to actually-changed fields keeps you well under the 50-future-calls-per-transaction cap on bulk loads.
